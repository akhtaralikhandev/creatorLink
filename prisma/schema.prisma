generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  BRAND
  CREATOR
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum CollaborationStatus {
  ACTIVE
  COMPLETED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
}

enum MediaType {
  IMAGE
  VIDEO
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  password      String?
  role          Role?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  brand         Brand?
  creator       Creator?
  notifications Notification[]
  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Brand {
  id          String   @id @default(cuid())
  userId      String   @unique
  companyName String
  industry    String?
  website     String?
  logoUrl     String?
  bio         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@map("brands")
}

model Creator {
  id               String   @id @default(cuid())
  userId           String   @unique
  displayName      String
  bio              String?
  niche            String?
  instagramHandle  String?
  tiktokHandle     String?
  country          String?
  profileImageUrl  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications   Application[]
  portfolioItems PortfolioItem[]

  @@map("creators")
}

model Campaign {
  id          String         @id @default(cuid())
  brandId     String
  title       String
  description String?        @db.Text
  budget      Decimal?       @db.Decimal(10, 2)
  niche       String?
  status      CampaignStatus @default(DRAFT)
  coverImage  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  brand        Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  applications Application[]

  @@map("campaigns")
}

model Application {
  id          String            @id @default(cuid())
  campaignId  String
  creatorId   String
  status      ApplicationStatus @default(PENDING)
  pitch       String?           @db.Text
  appliedAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  campaign      Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator       Creator        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  collaboration Collaboration?

  @@unique([campaignId, creatorId])
  @@map("applications")
}

model Collaboration {
  id            String              @id @default(cuid())
  applicationId String              @unique
  agreedRate    Decimal             @db.Decimal(10, 2)
  status        CollaborationStatus @default(ACTIVE)
  notes         String?             @db.Text
  startedAt     DateTime            @default(now())
  completedAt   DateTime?
  updatedAt     DateTime            @updatedAt

  application      Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  contentSubmissions ContentSubmission[]
  payment          Payment?

  @@map("collaborations")
}

model ContentSubmission {
  id              String           @id @default(cuid())
  collaborationId String
  videoUrl        String
  caption         String?          @db.Text
  status          SubmissionStatus @default(PENDING)
  feedback        String?          @db.Text
  submittedAt     DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  collaboration Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)

  @@map("content_submissions")
}

model Payment {
  id              String        @id @default(cuid())
  collaborationId String        @unique
  amount          Decimal       @db.Decimal(10, 2)
  status          PaymentStatus @default(PENDING)
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  collaboration Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model PortfolioItem {
  id         String    @id @default(cuid())
  creatorId  String
  mediaUrl   String
  mediaType  MediaType
  caption    String?
  uploadedAt DateTime  @default(now())

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@map("portfolio_items")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  message   String
  type      String?
  linkHref  String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
